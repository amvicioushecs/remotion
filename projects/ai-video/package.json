{
  "name": "remotion-ai-video",
  "version": "1.0.0",
  "description": "Remotion project with AI integration for video generation",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render",
    "upgrade": "remotion upgrade",
    "test": "eslint src --ext ts,tsx,js,jsx && tsc",
    "generate": "ts-node src/examples/generateAIVideo.ts",
    "dev": "nodemon --watch src -e ts,tsx --exec 'ts-node' src/examples/generateAIVideo.ts",
    "setup": "npm install && echo 'Please create a .env file with your API keys'",
    "clean": "rm -rf out/ .remotion/",
    "chat": "ts-node src/tools/chat.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "openai": "^4.0.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.0",
    "@google/generative-ai": "^0.1.3",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/web": "^0.0.113",
    "eslint": "^8.47.0",
    "typescript": "^5.1.0",
    "@remotion/eslint-config": "^4.0.0",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1"
  }
}
